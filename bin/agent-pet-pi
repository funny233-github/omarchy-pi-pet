#!/usr/bin/env bash
# agent-pet-pi —— 宠物唯一允许 spawn 子 pi 的地方。
#
# 这里把"严格定制"写死：不加载宿主任何扩展/技能/提示模板/上下文文件/MCP，不信任项目 .pi，
# 工具面由 --tools 全量替换（空 = 零工具），扩展面只有 -e 列出来的那些。
# 任何绕过这个脚本去调 pi 的代码路径，都算泄漏。
#
# 参数全部走 argv（提示词走 stdin，绝不进进程参数）：
#   --model <id>          必填，空则拒绝启动（绝不用 pi 的默认模型偷偷跑）
#   --provider <name>     可选，同名模型消歧
#   --thinking <level>    off|minimal|low|medium|high|xhigh|max，默认 low
#   --session <id>        会话 ID，空 = --no-session（无状态）
#   --tools <a,b>         工具白名单，空 = -nt（零工具）
#   --ext <path>          额外扩展，可重复；宠物自己的 ext/pet.ts 总会加载
#   --lang <zh|en>        选 persona 文件（说话模式）
#   --stream <1|0>        1 = --mode json（流式），0 = --mode text
#   --compact             不生成回复，对 --session 的持久会话做一次上下文压缩
#   --plugin <dir>        插件目录（默认从脚本位置推）
#   --state <dir>         状态目录（默认 ~/.local/state/agent-pet）
#
# 注意：在 sandboxfs 挂载上无法置可执行位，调用方一律用 `bash <path>`。

set -uo pipefail

die() { printf 'agent-pet-pi: %s\n' "$2" >&2; exit "$1"; }

self_dir=$(cd "$(dirname "$0")" && pwd) || die 1 "cannot resolve script dir"
plugin=${AGENT_PET_PLUGIN:-$(cd "$self_dir/.." && pwd)}
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
state=${AGENT_PET_STATE:-$state_home/agent-pet}

model="" provider="" thinking=low session=agent-pet tools=pet_state lang=zh stream=1 compact=0
exts=()

while (( $# )); do
  case $1 in
    --model) model=${2-}; shift 2 ;;
    --provider) provider=${2-}; shift 2 ;;
    --thinking) thinking=${2-}; shift 2 ;;
    --session) session=${2-}; shift 2 ;;
    --tools) tools=${2-}; shift 2 ;;
    --ext) exts+=("${2-}"); shift 2 ;;
    --lang) lang=${2-}; shift 2 ;;
    --stream) stream=${2-1}; shift 2 ;;
    --compact) compact=1; shift ;;
    --plugin) plugin=${2-}; shift 2 ;;
    --state) state=${2-}; shift 2 ;;
    *) die 2 "unknown argument: $1" ;;
  esac
done

[[ -n $model ]] || die 2 "no --model given; refusing to fall back to pi's default model"
[[ -n $plugin && -d $plugin ]] || die 1 "plugin dir not found: $plugin"
command -v pi >/dev/null || die 127 "pi not found on PATH"

mkdir -p "$state/pi-cwd" "$state/pi-sessions" || die 1 "cannot create state dirs under $state"
cd "$state/pi-cwd" || die 1 "cannot enter work dir"

# 公共隔离 flag（说话与 compact 共用）
common=(--model "$model")
[[ -n $provider ]] && common+=(--provider "$provider")
common+=(--thinking "$thinking")
if [[ -n $session ]]; then
  common+=(--session-id "$session" --session-dir "$state/pi-sessions")
else
  common+=(--no-session)
fi
common+=(--no-extensions -e "$plugin/ext/pet.ts")
remote_ext=0
for path in ${exts+"${exts[@]}"}; do
  [[ -n $path ]] || continue
  case $path in
    npm:*|git:*|http://*|https://*)
      # pi 的包源：由 pi 自己装进 ~/.pi/agent/tmp/extensions/，脚本不校验也不复制
      common+=(-e "$path")
      remote_ext=1
      ;;
    *)
      [[ $path == /* ]] || path="$config_home/agent-pet/$path"
      [[ -e $path ]] || die 78 "extension not found: $path"
      common+=(-e "$path")
      ;;
  esac
done
if [[ -n $tools ]]; then
  common+=(--tools "$tools")
else
  common+=(-nt)
fi
common+=(--no-mcp --no-skills --no-prompt-templates --no-context-files --no-approve)

# 剥掉会改变 pi 行为的继承变量（用户可能全局设了），再打上宠物自己的标记。
# 离线模式只在没有包源时开启。pi 的 package-manager 在离线模式下直接跳过缺失包的安装
# （package-manager.js:1014 `if (isOfflineModeEnabled()) return false`），
# 会让 `-e npm:...` 静默失效，所以装了包源就关掉它。
offline=1
[[ $remote_ext == 1 ]] && offline=0

clean_env() {
  # exec 放在函数体内：bash 的 `exec 函数名` 会把它当外部命令报 not found
  local -a env_args=(
    -u PI_CODING_AGENT_DIR -u PI_CODING_AGENT_SESSION_DIR -u PI_PACKAGE_DIR
    -u PI_CODING_AGENT -u PI_SESSION_ID -u PI_SESSION_FILE -u PI_PROVIDER
    -u PI_MODEL -u PI_REASONING_LEVEL
    AGENT_PET_INTERNAL=1 PI_TELEMETRY=0 PI_SKIP_VERSION_CHECK=1
  )
  [[ $offline == 1 ]] && env_args+=(PI_OFFLINE=1)
  exec env "${env_args[@]}" "$@"
}

# ---------------------------------------------------------------- compact
# 用 RPC 的 compact 命令压缩持久会话。pi --mode rpc 在 stdin EOF 时立即 shutdown，
# 会跟异步 compact 抢跑，所以用 coproc 保持 stdin 打开，读到 compact 响应才关。
if [[ $compact == 1 ]]; then
  [[ -n $session ]] || die 2 "stateless session has nothing to compact"
  coproc RPC { clean_env pi --mode rpc "${common[@]}"; }
  printf '{"type":"compact","id":"c1"}\n' >&"${RPC[1]}"

  result=""
  while IFS= read -r line <&"${RPC[0]}"; do
    if [[ $line == *'"command":"compact"'* ]]; then
      result=$line
      break
    fi
  done

  # 不显式关 fd / wait：拿到了响应就可以走。退出时 bash 关掉管道，
  # 子进程 stdin 收到 EOF 自己收尾（coproc 的 fd 变量在进程退出后可能已被清掉）。
  if [[ -n $result ]]; then
    # 输出原始 response JSON，交给 Service 解析（脚本不依赖 jq）
    printf '%s\n' "$result"
    exit 0
  fi
  echo "no-response" >&2
  exit 1
fi

# ---------------------------------------------------------------- 说话
persona="$plugin/assets/persona.$lang.md"
[[ -f $persona ]] || persona="$plugin/assets/persona.zh.md"
[[ -f $persona ]] || die 2 "persona prompt missing under $plugin/assets"

mode=json
[[ $stream == 0 ]] && mode=text

clean_env pi --print --mode "$mode" --system-prompt "$persona" "${common[@]}"
