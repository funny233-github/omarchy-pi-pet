#!/usr/bin/env bash
# 给宠物自己的 pi 装上 pi-web-access（可选的联网能力）。
#
# 为什么单独装到自己的目录：宠物子进程用 --no-extensions + 显式 -e 加载，
# 不碰你的 ~/.pi/agent/extensions；这里把它装进 ~/.config/agent-pet/ext/ 下，
# 只有宠物那个子进程会用到。
#
# 关键细节：npm 默认会把 peerDependencies（typebox、@earendil-works/pi-*）
# 也装一份进 node_modules，而 pi 的文档明确警告这会绕过它的模块映射、产生重复实例，
# 所以这里必须 --omit=peer。
#
# 用法：
#   bin/agent-pet-web-access            # 安装并打印要加的配置
#   bin/agent-pet-web-access --uninstall # 删除装好的目录

set -uo pipefail

die() { printf 'agent-pet-web-access: %s\n' "$2" >&2; exit "$1"; }

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
dest="$config_home/agent-pet/ext/pi-web-access"

if [[ ${1:-} == --uninstall ]]; then
  [[ -d $dest ]] || { echo "没装过（$dest 不存在）"; exit 0; }
  rm -rf -- "$dest" && echo "已删除 $dest（记得把 config.jsonc 里的 extensions/tools 一起删掉）"
  exit 0
fi

command -v npm >/dev/null || die 127 "npm not found on PATH"
command -v node >/dev/null || die 127 "node not found on PATH"

mkdir -p "$dest" || die 1 "cannot create $dest"
cd "$dest" || die 1 "cannot enter $dest"
[[ -f package.json ]] || printf '{"name":"agent-pet-ext","private":true}\n' > package.json

echo "安装 pi-web-access 到 $dest ……"
npm install --no-audit --no-fund --omit=peer pi-web-access || die 1 "npm install failed"

pkg="$dest/node_modules/pi-web-access"
entry="$pkg/dist/index.js"
[[ -f $entry ]] || die 1 "安装后找不到入口：$entry"

for tool in web_search fetch_content; do
  grep -q "\"$tool\"" "$pkg/dist/index.js" || die 1 "这个版本里没有工具 $tool，检查 pi-web-access 版本"
done

cat <<EOF

装好了：$entry

把下面两行并进 ~/.config/agent-pet/config.jsonc 的 "murmur" 里：

  "extensions": ["ext/pi-web-access/node_modules/pi-web-access/dist/index.js"],
  "tools": ["pet_state", "web_search", "fetch_content"]

说明：
  - 相对路径按 ~/.config/agent-pet/ 解析（不是 cwd）
  - tools 是白名单：不列出来模型就调不到。还想给她 source_check / get_search_content 就自己加
  - 零配置走 Exa MCP，不需要 key；要指定服务商就把 key 写进 ~/.pi/agent/web-search.json
  - 保存配置后不用重启 shell（热重载），下次说话即生效

卸载：$0 --uninstall
EOF
